.env
.env.local
.DS_Store

# Root-level JS tooling (frontend uses frontend/.gitignore for its node_modules)
node_modules/
backups/
tmp/
.claude/

# Local agent run artifacts
.agents/runs/*
!.agents/runs/README.md

# Test outputs, Allure, coverage (do not push local/CI artifacts)
**/test-results/
**/allure-results/
**/allure-report/
.allure/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
**/playwright-report/

# Downloaded CI merge dirs, allure-variables.json, merged env fragments, junit copies, etc.
artifacts/

# Generated when reproducing Allure PR comment locally
allure-pr-comment.md

# Editor / OS (optional local noise)
.idea/
*.swp
*.swo
