.env
.env.local
.DS_Store

# Root-level JS tooling (frontend uses frontend/.gitignore for its node_modules)
node_modules/
backups/
tmp/
.claude/

# Local agent run artifacts
.agents/runs/*
!.agents/runs/README.md

# Test outputs, Allure, coverage (do not push local/CI artifacts)
**/test-results/
**/allure-results/
**/allure-report/
.allure/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
**/playwright-report/

# Downloaded CI merge dirs, allure-variables.json, merged env fragments, junit copies, etc.
artifacts/

# Generated when reproducing Allure PR comment locally
allure-pr-comment.md

# Local MCP tokens merged by scripts/mcp/install-user.mjs
mcp/local.overrides.json

# MemPalace — local wing wiring and entity scan (keep out of git for personal setups)
/mempalace.yaml
/entities.json

# Editor / OS (optional local noise)
.idea/
*.swp
*.swo

# Django MEDIA_ROOT: PDF exports, invoices, uploads — not versioned (backup: scripts/media-backup.sh)
backend/media/*
!backend/media/.gitkeep

# Figma / design pipeline: Playwright writes to repo-root output/ (see frontend/e2e/*-collect*.spec.ts)
/output/

# tools/figma-mcp — install deps locally (npm ci), do not commit node_modules
tools/figma-mcp/node_modules/
