COMPOSE_PROJECT_NAME=car-service-platform

FRONTEND_PORT=4173
# Vite dev (Docker): host port mapped to Vite in container (default matches FRONTEND_PORT). If 4173 is busy (e.g. prod stack), use e.g. 5173.
FRONTEND_DEV_PORT=4173
# Optional override of allowed browser origins (defaults include FRONTEND_DEV_PORT + localhost:5173 for local npm run dev).
# CORS_DEV_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
BACKEND_PORT=8000
DB_PORT=5432

POSTGRES_DB=car_service_platform
POSTGRES_USER=car_service_platform
POSTGRES_PASSWORD=change-me-in-production

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# For Docker + Vite dev proxy, include the compose service name `backend` (see docker-compose.yml default).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Include 127.0.0.1 — Playwright E2E and CI use PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173; CSRF_TRUSTED_ORIGINS mirrors this list.
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4174,http://127.0.0.1:4173
TIME_ZONE=Europe/Warsaw

ADMIN_EMAIL=admin@autoservice.local
ADMIN_PASSWORD=change-me-in-production
STAFF_EMAIL=staff@autoservice.local
STAFF_PASSWORD=change-me-in-production

LOG_LEVEL=INFO
LOG_FORMAT=text
GUNICORN_WORKERS=1
