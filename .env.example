COMPOSE_PROJECT_NAME=car-service-platform

FRONTEND_PORT=4173
# Vite dev (Docker): host port mapped to Vite in container (default matches FRONTEND_PORT). If 4173 is busy (e.g. prod stack), use e.g. 5173.
FRONTEND_DEV_PORT=4173
# Optional override of allowed browser origins (defaults include FRONTEND_DEV_PORT + localhost:5173 for local npm run dev).
# CORS_DEV_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
# Dev stack binds Vite + Django to 127.0.0.1 only. For same-Wi‑Fi devices: bash scripts/compose/publish-dev-to-lan.sh
# Optional if auto IP detection fails: DEV_LAN_IP=192.168.x.x
BACKEND_PORT=8000
DB_PORT=5432

POSTGRES_DB=car_service_platform
POSTGRES_USER=car_service_platform
POSTGRES_PASSWORD=change-me-in-production

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# For Docker + Vite dev proxy, include the compose service name `backend` (see docker-compose.yml default).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Include 127.0.0.1 — Playwright E2E and CI use PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173; CSRF_TRUSTED_ORIGINS mirrors this list.
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4174,http://127.0.0.1:4173
#
# Phone / tablet on same Wi‑Fi when using **local** `npm run dev` (Vite default port 5173), not Docker:
# append your PC's LAN IPv4 and port to BOTH lists (CSRF + CORS use the same origins):
#   CORS_ALLOWED_ORIGINS=http://localhost:4173,...,http://127.0.0.1:5173,http://192.168.x.x:5173
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.x.x
# Docker LAN publish adds these automatically via scripts/compose/publish-dev-to-lan.sh — raw npm dev does not.
TIME_ZONE=Europe/Warsaw

ADMIN_EMAIL=admin@autoservice.local
ADMIN_PASSWORD=admin12345
STAFF_EMAIL=staff@autoservice.local
STAFF_PASSWORD=staff12345

# Frontend (Vite dev / Docker dev stack): open /app already signed in as admin when backend returns 401 on /auth/me.
# Set to false to always use the login screen. Ignored in production builds and in Vitest (MODE=test).
VITE_DEV_AUTO_LOGIN=true
# Optional overrides (defaults fall back to ADMIN_EMAIL / ADMIN_PASSWORD above when using docker-compose.dev.yml).
# VITE_DEV_LOGIN_EMAIL=admin@autoservice.local
# VITE_DEV_LOGIN_PASSWORD=admin12345

# Sentry (leave empty to disable locally)
SENTRY_DSN=
VITE_SENTRY_DSN=

LOG_LEVEL=INFO
LOG_FORMAT=text
GUNICORN_WORKERS=1

# ─── Railway production ───────────────────────────────────────────────────────
# Set these in Railway dashboard > service > Variables (NOT in this file).
# Reference only — copy what you need to the Railway dashboard.
#
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DJANGO_ALLOWED_HOSTS=your-backend.up.railway.app
# CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
# FRONTEND_URL=https://your-frontend.up.railway.app
# BACKEND_URL=http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:8000
# MEDIA_ROOT=/data/media
# POSTGRES_DB=${{Postgres.PGDATABASE}}
# POSTGRES_USER=${{Postgres.PGUSER}}
# POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}
# POSTGRES_HOST=${{Postgres.PGHOST}}
# POSTGRES_PORT=${{Postgres.PGPORT}}
# GUNICORN_WORKERS=2
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=<strong-password>
# STAFF_EMAIL=staff@yourdomain.com
# STAFF_PASSWORD=<strong-password>
#
# Sentry (set in Railway dashboard > service > Variables)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
#
# Frontend Sentry (Railway build-time variables — set in Railway dashboard > service > Variables)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
#
# Sentry source map upload (Railway build-time, only needed if uploading source maps)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
